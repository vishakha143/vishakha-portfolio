# Local dev only. The /admin page is not included in production builds.
VITE_ADMIN_PASSWORD=choose-a-password

# Cloudinary image uploads for /admin (signed by the local dev server).
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# No VITE_ prefix on purpose: these stay in Node and are never sent to the browser.
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional alternative: an UNSIGNED upload preset instead of the key/secret above.
# VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
